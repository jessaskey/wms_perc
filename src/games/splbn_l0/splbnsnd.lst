5170   BCF5             ___scsy = ___seng+(___snumh*2)
5171   BCF5             
5172   BCF5             #define 	reg_speech(name,start,end)  \ .org ___seng
5173   BCF5             #defcont   \ .dw start, end
5174   BCF5             #defcont   \___seng .set ___seng+4
5175   BCF5             #defcont   \name = ___shnum
5176   BCF5             #defcont   \___shnum .set ___shnum+1
5177   BCF5             #defcont   \ .org ___scsy
5178   BCF5             #defcont   \___scsy .set ___scsy+2	
5179   BCF5             
