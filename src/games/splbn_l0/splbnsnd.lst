0942   F065             ;******************************************************************
0943   F065             ; This routine takes a X byte (largest value known so far is $5B)
0944   F065             ; buffer and it fills it with NOP commands that are the length of
0945   F065             ; A/2, if A is odd, then something happens with the buffer data
0946   F065             ; having a CMPA at the end for some reason.
0947   F065             ;******************************************************************
0948   F065             sp_fill_ramexec
0949   F065 CE 00 1C    		ldx	#delaybuf
0950   F068 80 02       		suba	#$02					;A contains the pitch value
0951   F06A                         begin
0951   F06A             
