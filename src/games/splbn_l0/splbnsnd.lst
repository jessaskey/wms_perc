1441   FC33             ;**************************************************************
1442   FC33             ;* Master Command Lookup Table - This table contains two bytes
1443   FC33             ;* per command, the first byte is the controlling routine that
1444   FC33             ;* is called and the second byte is the register a data that
1445   FC33             ;* routine requires. The lookup starts with command 01 since 
1446   FC33             ;* command 00 does nothing.
1447   FC33             ;**************************************************************
1448   FC33             ;sndcmd_tilt    .equ  $01
1449   FC33             ;sndcmd_gameover .equ 
1450   FC33             
1451   FC33             ___snum = 0;
1452   FC33             
1453   FC33             #define SNDCMD(cmdlbl,handler,p1,p2)    \cmdlbl = ___snum^$3f
1454   FC33             #defcont                                \___snum .set ___snum+1
1455   FC33             #defcont                                \ .db handler
1456   FC33             #defcont                                \ .db p1 
1457   FC33             #defcont                                \ .db p2 
