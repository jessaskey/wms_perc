0634   F07D 6F 01       		clr	    $01,x                   ;#$00
0635   F07F 08          		inx
0636   F080 08          		inx
0637   F081             sp_fill_end
0638   F081 C6 7E       		ldab	#$7E					;This puts a JMP to sp_delay_ret at the end of the buffer
0639   F083 E7 00       		stab	$00,x
0640   F085 C6 DF       		ldab	#(sp_delay_ret>>8)
0641   F087 E7 01       		stab	$01,x
