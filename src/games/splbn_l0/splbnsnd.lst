0091   001C             mod1b			.block	1
0092   001D             
0093   001D             ptr_sweep_start	.block	2	;001C
0094   001F             ptr_sweep_end	.block	2	;001E
0095   0021             ptr_sweep_last	.block	2	;0020
0096   0023             
0097   0023             swp22			.block	1
0098   0024             swp23			.block	1
0099   0025             swp24			.block	1
0100   0026             swpbase		    .block	1
0101   0027             
0102   0027             ;*******************************************
0103   0027             ;* Additive Sounds
0104   0015             .org			local_base
0105   0015             sum_t1_init		.block	1
0106   0016             sum_t2_init		.block	1
0107   0017             sum_t1_adder	.block	1
0108   0018             sum_t2_adder	.block	1
0109   0019             sum_t2_max		.block	1
0110   001A             sum_all_max		.block	2
0111   001C             sum_t1_ext		.block	1
0112   001D             sum_dac		    .block	1
0113   001E             sum_t1_value	.block	1
0114   001F             sum_t2_value	.block	1
0115   0020             
0116   0020             ;*******************************************
0117   0020             ;* Simple Sounds
0118   0017             .org			local_base+2
0119   0017             sim_delay		.block	1
0120   0018             sim_non		.block	3
0121   001B             sim_initial		.block	1
0122   001C             sim_adder		.block	1
0123   001D             
0124   001D             ;*******************************************
0125   001D             ;* Special Sounds
0126   0015             .org			local_base
0127   0015             ssnd_adder		.block	1
0128   0016             ssnd_dac		.block	1
0129   0017             ssnd_cycles		.block	1
0130   0018             ssnd_period		.block	2
0131   001A             ssnd_flag		.block	1
0132   001B             
0133   001B             ;*******************************************
0134   001B             
0135   001B             
0136   001B             
0137   001B             
0138   001B             ;*******************************************
0139   001B             ;* Hardware Definitions
0140   001B             ;*******************************************	
0141   001B             pia_dreg_a           .equ    $0400
0142   001B             pic_creg_a           .equ    $0401
0143   001B             pia_dreg_b           .equ    $0402
0144   001B             pia_creg_b           .equ    $0403
0145   001B             
0146   001B             pia_dac_out		    .equ	pia_dreg_a
0147   001B             pia_speech_data	    .equ	pic_creg_a 
0148   001B             pia_sound_command	.equ	pia_dreg_b
0149   001B             pia_speech_clk	    .equ	pia_creg_b
0150   001B             
0151   001B             PIA_CONT_OUT        .equ    $20
0152   001B             PIA_CONT_INT        .equ    0
0153   001B             PIA_CONT_OUT_STROBE .equ    0
0154   001B             PIA_CONT_OUT_SETRES .equ    $10
0155   001B             PIA_CONT_OUT_SET    .equ    $08
0156   001B             PIA_CONT_OUT_CLR    .equ    0
0157   001B             PIA_REGSEL_DDR      .equ    0
0158   001B             PIA_REGSEL_OUT      .equ    $04
0159   001B             PIA_CONT_IRQ_HILO   .equ    0
0160   001B             PIA_CONT_IRQ_LOHI   .equ    $02
0161   001B             PIA_CONT_IRQ_ON     .equ    $01
0162   001B             PIA_CONT_IRQ_OFF    .equ    0
0163   001B             
0164   001B             PIA_DATA_SET        .equ PIA_CONT_OUT+PIA_CONT_OUT_SETRES+PIA_CONT_OUT_SET+PIA_REGSEL_OUT+PIA_CONT_IRQ_HILO+PIA_CONT_IRQ_OFF    ;3C
0165   001B             PIA_DATA_CLR        .equ PIA_CONT_OUT+PIA_CONT_OUT_SETRES+PIA_CONT_OUT_CLR+PIA_REGSEL_OUT+PIA_CONT_IRQ_HILO+PIA_CONT_IRQ_OFF    ;34.
0166   001B             
0167   001B             PIA_CLK_SET         .equ PIA_CONT_OUT+PIA_CONT_OUT_SETRES+PIA_CONT_OUT_SET+PIA_REGSEL_OUT+PIA_CONT_IRQ_LOHI+PIA_CONT_IRQ_ON  ;$3F
0168   001B             PIA_CLK_CLR         .equ PIA_CONT_OUT+PIA_CONT_OUT_SETRES+PIA_CONT_OUT_CLR+PIA_REGSEL_OUT+PIA_CONT_IRQ_LOHI+PIA_CONT_IRQ_ON  ;$37
0169   001B             
0170   001B             
0171   001B~            #IF emulate
0172   001B~            	.org	$8000
0173   001B             #ELSE
0174   B000             	.org	$b000
0175   B000             #ENDIF
