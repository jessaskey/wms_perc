0612   F065             ;******************************************************************
0613   F065             ; This routine takes a X byte (largest value known so far is $5B)
0614   F065             ; buffer and it fills it with NOP commands that are the length of
0615   F065             ; A/2, if A is odd, then something happens with the buffer data
0616   F065             ; having a CMPA at the end for some reason.
0617   F065             ;******************************************************************
0618   F065             sp_fill_ramexec
0619   F065 CE 00 1C    		ldx	#delaybuf
0620   F068 80 02       		suba	#$02					;A contains the pitch value
0621   F06A                         begin
