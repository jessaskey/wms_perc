0623   F06C 81 03             		cmpa	#$03
0624   F06E 27 09             		beq	sp_fill_odd				;if it ended on an $03, then put in a $91,$00
0625   F070 C6 01             		ldab	#$01					;this is a NOP command here
0626   F072 E7 00             		stab	$00,x					;put it in the buffer
0627   F074 08                		inx
0628   F075 80 02             		suba	#$02
0629   F077             		loopend
0629   F077             
0629   F077             
0629   F077~            		loopend
0629   F077~            		loopend
0629   F077~            		loopend
