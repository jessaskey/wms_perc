5792   F08E             sp_fill_odd
5793   F08E C6 91       		ldab	#$91
5794   F090 E7 00       		stab	$00,x
5795   F092 6F 01       		clr	$01,x
5796   F094 08          		inx
5797   F095 08          		inx
5798   F096             sp_fill_end
5799   F096 C6 7E       		ldab	#$7E					;This puts a JMP to sp_delay_ret at the end of the buffer
5800   F098 E7 00       		stab	$00,x
5801   F09A C6 BF       		ldab	#(sp_delay_ret>>8)
5802   F09C E7 01       		stab	$01,x
5803   F09E C6 8B       		ldab	#(sp_delay_ret&$FF)
5804   F0A0 E7 02       		stab	$02,x
