0083   0018             ;* Modulated Sounds
0084   0015             .org			local_base
0085   0015             mod14			.block	1
0086   0016             mod15			.block	1	
0087   0017             mod16			.block	1
0088   0018             mod17			.block	1
0089   0019             mod18			.block	1
