0963   F07B E7 00       		stab	$00,x
0964   F07D 6F 01       		clr	    $01,x                   ;#$00
0965   F07F 08          		inx
0966   F080 08          		inx
0967   F081             sp_fill_end
0968   F081 C6 7E       		ldab	#$7E					;This puts a JMP to sp_delay_ret at the end of the buffer
0969   F083 E7 00       		stab	$00,x
0970   F085 C6 E0       		ldab	#(sp_delay_ret>>8)
0971   F087 E7 01       		stab	$01,x
0972   F089 C6 3D       		ldab	#(sp_delay_ret&$FF)
0973   F08B E7 02       		stab	$02,x
