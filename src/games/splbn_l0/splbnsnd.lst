0953   F06C 81 03             		cmpa	#$03
0954   F06E 27 09             		beq	sp_fill_odd				;if it ended on an $03, then put in a $91,$00
0955   F070 C6 01             		ldab	#$01					;this is a NOP command here
0956   F072 E7 00             		stab	$00,x					;put it in the buffer
0957   F074 08                		inx
0958   F075 80 02             		suba	#$02
0959   F077             		loopend
0959   F077             
0959   F077             
0959   F077~            		loopend
0959   F077~            		loopend
