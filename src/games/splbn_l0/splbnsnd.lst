5773   F07A             ;******************************************************************
5774   F07A             ; This routine takes a X byte (largest value known so far is $5B)
5775   F07A             ; buffer and it fills it with NOP commands that are the length of
5776   F07A             ; A/2, if A is odd, then something happens with the buffer data
5777   F07A             ; having a CMPA at the end for some reason.
5778   F07A             ;******************************************************************
5779   F07A             sp_fill_ramexec
5780   F07A CE 00 1C    		ldx	#delaybuf
5781   F07D 80 02       		suba	#$02					;A contains the pitch value
5782   F07F                         begin
5782   F07F             
5783   F07F 23 15             		bls	sp_fill_end				;If A is less than zero, then we are done filling
5784   F081 81 03             		cmpa	#$03
5785   F083 27 09             		beq	sp_fill_odd				;if it ended on an $03, then put in a $91,$00
5786   F085 C6 01             		ldab	#$01					;this is a NOP command here
5787   F087 E7 00             		stab	$00,x					;put it in the buffer
5788   F089 08                		inx
5789   F08A 80 02             		suba	#$02
5790   F08C             		loopend
5790   F08C             
5790   F08C             
5790   F08C~            		loopend
5790   F08C~            		loopend
5790   F08C~            		loopend
