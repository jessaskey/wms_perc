1886   DBB5 DF B8                   stx temp1
1887   DBB7 0D                      sec 
1888   DBB8 DE CD                   ldx vm_nextslot         ;Get Next Available Slot Address
1889   DBBA                         ifne
1889   DBBA             
1889   DBBA 27 FE       
1890   DBBC 36                          psha    
1891   DBBD A6 00                       ldaa    $00,X               ;\
1892   DBBF 97 CD                       staa    vm_nextslot         ;|---- Set New Next Available Slot Address
1893   DBC1 A6 01                       ldaa    $01,X               ;|
1894   DBC3 97 CE                       staa    vm_nextslot+1       ;/
1895   DBC5 DF BA                       stx     temp2               ;Temp2 = New Thread Base Address
1896   DBC7 DE D1                       ldx     vm_tail_thread      ;This is the last thread in the vm, it has the tail
1897   DBC9 A6 00                       ldaa    $00,X               ;\
1898   DBCB 97 BC                       staa    temp3               ;|
1899   DBCD A6 01                       ldaa    $01,X               ;|---- Store the running threads next pointer in temp3
1900   DBCF 97 BD                       staa    temp3+1         ;/
1901   DBD1 96 BA                       ldaa    temp2               ;\
1902   DBD3 A7 00                       staa    $00,X               ;|
1903   DBD5 96 BB                       ldaa    temp2+1         ;|---- Put the new thread into the running threads next pointer
1904   DBD7 A7 01                       staa    $01,X               ;/
1905   DBD9 EE 00                       ldx     $00,X
1906   DBDB DF D1                       stx     vm_tail_thread      ;Make the new thread the last thread
1907   DBDD 96 BC                       ldaa    temp3               ;\
1908   DBDF A7 00                       staa    $00,X               ;|
1909   DBE1 96 BD                       ldaa    temp3+1         ;|---- Set the Next pointer of the new thread to the 
1910   DBE3 A7 01                       staa    $01,X               ;/     previous threads next pointer.
1911   DBE5 96 B8                       ldaa    temp1
1912   DBE7 A7 0B                       staa    $0B,X
1913   DBE9 96 B9                       ldaa    temp1+1
1914   DBEB A7 0C                       staa    $0C,X
1915   DBED 96 C8                       ldaa    thread_priority     ;Store the priority
1916   DBEF A7 0D                       staa    $0D,X
1917   DBF1 96 C4                       ldaa    sys_temp_w2         ;Push variables from sys_temp_w2
1918   DBF3 A7 10                       staa    $10,X
1919   DBF5 96 C5                       ldaa    sys_temp_w2+1
1920   DBF7 A7 11                       staa    $11,X
1921   DBF9 32                          pula    
1922   DBFA A7 0E                       staa    $0E,X               ;Store reg A
1923   DBFC E7 0F                       stab    $0F,X               ;Store reg B
1924   DBFE 6F 02                       clr $02,X               ;Reset the counter
