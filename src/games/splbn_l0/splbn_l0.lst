1384   D86C             
1385   D86C 6F 01                               clr pia_control,X   ;Initialize all PIA data direction registers
1386   D86E 32                                  pula                ;Get DDR data
1387   D86F A7 00                               staa    pia_pir,X
1388   D871 32                                  pula    
1389   D872 A7 01                               staa    pia_control,X   ;Get Control Data
1390   D874 8C 21 00                            cpx #pia_sound_data ;This is the last PIA to do in shooter games
1391   D877                                     ifne
1391   D877             
1391   D877 27 FE       
1392   D879 6F 00                                   clr pia_pir,X       ;If we are on the sound PIA, then clear the PIR 
1393   D87B                                     endif
