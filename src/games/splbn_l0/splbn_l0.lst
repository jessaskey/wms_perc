2042   DC6F 27 FE       
2043   DC71 A7 00       _sb01               staa    $00,X               ;Insert Solenoid Into Buffer
2044   DC73 08                              inx 
2045   DC74 DF B6                           stx solenoid_queue_pointer  ;Update Pointer
2046   DC76 0C          _sb02               clc                 ;Carry Cleared on Buffer Add
2047   DC77                             endif
