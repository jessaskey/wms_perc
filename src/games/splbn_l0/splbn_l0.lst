1813   DB02 97 CB                       staa    vm_nextslot         ;|---- Set New Next Available Slot Address
1814   DB04 A6 01                       ldaa    $01,X               ;|
1815   DB06 97 CC                       staa    vm_nextslot+1       ;/
1816   DB08 DF B8                       stx     temp2               ;Temp2 = New Thread Base Address
1817   DB0A DE CF                       ldx     vm_tail_thread      ;This is the last thread in the vm, it has the tail
1818   DB0C A6 00                       ldaa    $00,X               ;\
1819   DB0E 97 BA                       staa    temp3               ;|
1820   DB10 A6 01                       ldaa    $01,X               ;|---- Store the running threads next pointer in temp3
1821   DB12 97 BB                       staa    temp3+1         ;/
1822   DB14 96 B8                       ldaa    temp2               ;\
1823   DB16 A7 00                       staa    $00,X               ;|
1824   DB18 96 B9                       ldaa    temp2+1         ;|---- Put the new thread into the running threads next pointer
1825   DB1A A7 01                       staa    $01,X               ;/
1826   DB1C EE 00                       ldx     $00,X
1827   DB1E DF CF                       stx     vm_tail_thread      ;Make the new thread the last thread
