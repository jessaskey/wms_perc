3386   E32A             ;*************************************************************************
3387   E32A             ;* Turn On Lamp: Lamp number is in A (packed format). This can also be 
3388   E32A             ;*               used to set a bitflag.
3389   E32A             ;*************************************************************************
3390   E32A DF BC       lamp_on         stx temp3
3391   E32C CE 00 10    lamp_onx        ldx #lampbuffer0            ;Set up correct index to lampbuffer
3392   E32F 37          lamp_or         pshb    
