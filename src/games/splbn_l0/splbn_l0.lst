0647+  0000             #define EQUAL_      $FC
0648+  0000             #define LOGIC_OR_   $FB
0649+  0000             #define LOGIC_AND_  $FA
0650+  0000             #define ADD_        $F9
0651+  0000             #define SWITCH_     $F8
0652+  0000             #define BIT_        $F7
