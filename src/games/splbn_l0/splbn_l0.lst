1371   D853 0F          reset       sei 
1372   D854 8E E2 92                lds #pia_ddr_data-1     ;Point stack to start of init data
1373   D857 C6 0C                   ldab    #$0C                ;Number of PIA sections to initialize
1374   D859 CE 21 00                ldx #pia_sound_data     ;Start with the lowest PIA
1375   D85C 86 04                   ldaa    #$04
