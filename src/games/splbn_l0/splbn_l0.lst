1891   DBC2             newthread_sp
1892   DBC2 DF B8                   stx temp1
1893   DBC4 0D                      sec 
1894   DBC5 DE CD                   ldx vm_nextslot         ;Get Next Available Slot Address
1895   DBC7                         ifne
1895   DBC7             
1895   DBC7 27 FE       
1896   DBC9 36                          psha    
1897   DBCA A6 00                       ldaa    $00,X               ;\
1898   DBCC 97 CD                       staa    vm_nextslot         ;|---- Set New Next Available Slot Address
1899   DBCE A6 01                       ldaa    $01,X               ;|
1900   DBD0 97 CE                       staa    vm_nextslot+1       ;/
1901   DBD2 DF BA                       stx     temp2               ;Temp2 = New Thread Base Address
1902   DBD4 DE D1                       ldx     vm_tail_thread      ;This is the last thread in the vm, it has the tail
1903   DBD6 A6 00                       ldaa    $00,X               ;\
1904   DBD8 97 BC                       staa    temp3               ;|
1905   DBDA A6 01                       ldaa    $01,X               ;|---- Store the running threads next pointer in temp3
1906   DBDC 97 BD                       staa    temp3+1         ;/
1907   DBDE 96 BA                       ldaa    temp2               ;\
1908   DBE0 A7 00                       staa    $00,X               ;|
1909   DBE2 96 BB                       ldaa    temp2+1         ;|---- Put the new thread into the running threads next pointer
1910   DBE4 A7 01                       staa    $01,X               ;/
1911   DBE6 EE 00                       ldx     $00,X
1912   DBE8 DF D1                       stx     vm_tail_thread      ;Make the new thread the last thread
1913   DBEA 96 BC                       ldaa    temp3               ;\
1914   DBEC A7 00                       staa    $00,X               ;|
1915   DBEE 96 BD                       ldaa    temp3+1         ;|---- Set the Next pointer of the new thread to the 
1916   DBF0 A7 01                       staa    $01,X               ;/     previous threads next pointer.
1917   DBF2 96 B8                       ldaa    temp1
1918   DBF4 A7 0B                       staa    $0B,X
1919   DBF6 96 B9                       ldaa    temp1+1
1920   DBF8 A7 0C                       staa    $0C,X
