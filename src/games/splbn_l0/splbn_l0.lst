0654+  0000             #define RANGEOFF_   $F5
0655+  0000             #define LAMP_       $F4
0656+  0000             #define NOT_        $F3
0657+  0000             #define IMM_        $F2
0658+  0000             #define GAME_       $F1   
0659+  0000             #define TILT_       $F0
