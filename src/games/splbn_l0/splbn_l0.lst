1944   DBA3             ;*****************************************************************  
1945   DBA3             ;* Solenoid Queue Processing: This is the routine that is called
1946   DBA3             ;* to fire a specific solenoid. It will add the solenoid to the 
1947   DBA3             ;* queue. Works from top down. Solenoid Number is in A along with
1948   DBA3             ;* data on how to handle solenoid. Format of A is ...
1949   DBA3             ;*
1950   DBA3             ;*      XXXZZZZZ    Where: ZZZZZ is solenoid number 00-10d
1951   DBA3             ;*                       XXX is timer/command
1952   DBA3             ;*
1953   DBA3             ;* NOTE: Hyperball only allows 8 solenoids + Shooter + BallLift
1954   DBA3             ;*****************************************************************      
1955   DBA3 36          solbuf      psha                    ;Push Solenoid #
1956   DBA4 37                      pshb    
1957   DBA5 DF B6                   stx temp1               ;Put X into Temp1
1958   DBA7 DE B4                   ldx solenoid_queue_pointer  ;Check Solenoid Buffer
1959   DBA9 8C 11 18                cpx #sol_queue  
1960   DBAC                         ifne                    ;Buffer not full
1960   DBAC             
1960   DBAC 27 FE       
1961   DBAE 0D                          sec                 ;Carry Set if Buffer Full
1962   DBAF 8C 11 28                    cpx #sol_queue_end      ;Buffer end
1963   DBB2                             ifne
1963   DBB2             
1963   DBB2 27 FE       
1964   DBB4 A7 00       _sb01               staa    $00,X               ;Insert Solenoid Into Buffer
1965   DBB6 08                              inx 
1966   DBB7 DF B4                           stx solenoid_queue_pointer  ;Update Pointer
1967   DBB9 0C          _sb02               clc                 ;Carry Cleared on Buffer Add
1968   DBBA                             endif
