1715   DA9C             ;**************************************************************************
1716   DA9C             ;* Adds a new thread to the VM. The data for this routine is contained 
1717   DA9C             ;* directly after the jsr to this routine. A single byte follows the
1718   DA9C             ;* jsr and is the timer byte used for the delay until the thread starts.
1719   DA9C             ;* The actual address directly after the timer byte is where the thread
1720   DA9C             ;* will start running. Example:
1721   DA9C             ;*
1722   DA9C             ;*  jsr addthread
1723   DA9C             ;*    .db 05        ;This is the timer byte
1724   DA9C             ;*  ldaa #FF        ;This code is executed as the thread.
1725   DA9C             ;***************************************************************************
