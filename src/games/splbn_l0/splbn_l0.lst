1800   DB66             ;**************************************************************************
1801   DB66             ;* Adds a new thread to the VM. The data for this routine is contained 
1802   DB66             ;* directly after the jsr to this routine. A single byte follows the
1803   DB66             ;* jsr and is the timer byte used for the delay until the thread starts.
1804   DB66             ;* The actual address directly after the timer byte is where the thread
1805   DB66             ;* will start running. Example:
1806   DB66             ;*
1807   DB66             ;*  jsr addthread
1808   DB66             ;*    .db 05        ;This is the timer byte
1809   DB66             ;*  ldaa #FF        ;This code is executed as the thread.
1810   DB66             ;***************************************************************************
1811   DB66 DF B8       addthread   stx     temp1
1812   DB68 97 BA                   staa    temp2
1813   DB6A 30                      tsx 
1814   DB6B EE 00                   ldx     $00,X               ;Return Address from rts to $EA2F
1815   DB6D A6 00                   ldaa    $00,X               ;New Timer Value
